{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
      "builder": "NIXPACKS",
      "buildCommand": "bash build.sh"
    },
    "deploy": {
      "startCommand": "cd backend && gunicorn config.wsgi --bind 0.0.0.0:$PORT --workers 2 --threads 4 --timeout 120 -k gthread",
      "releaseCommand": "cd backend && python manage.py migrate --noinput",
      "healthcheckPath": "/api/health/",
      "healthcheckTimeout": 30,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }